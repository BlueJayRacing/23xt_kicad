(version 1)

# INA827 VSSOP-8 pads are now 0.45 mm wide with a 0.20 mm pad gap.
# Retain the existing local 0.15 mm routing clearance exception for U7/U10;
# all other Power-net clearance remains 0.20 mm.
(rule "INA827 VSSOP pad clearance"
  (constraint clearance (min 0.15mm))
  (condition "A.memberOfFootprint('U7') || A.memberOfFootprint('U10')")
)
